{
  "name": "rust-file-manager",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "setup:ps1": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-dev-env.ps1",
    "setup:sh": "bash ./scripts/setup-dev-env.sh",
    "check:env": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-dev-env.ps1 -CheckOnly",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "build:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/local-build.ps1",
    "build:local:sh": "bash ./scripts/local-build.sh",
    "package:plugins": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-plugins.ps1",
    "package:portable": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -PortableOnly",
    "package:all": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release.ps1"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^26.6.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
